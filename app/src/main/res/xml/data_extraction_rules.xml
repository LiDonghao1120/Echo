<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="echo.db" />
        <include domain="file" path="datastore/echo.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="echo.db" />
        <include domain="file" path="datastore/echo.preferences_pb" />
        <include domain="file" path="artists" />
    </device-transfer>
</data-extraction-rules>
