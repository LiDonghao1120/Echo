<resources>
    <style name="Theme.Echo.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Echo" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Echo.Base</item>
    </style>
    <color name="bg">#11100E</color>
    <color name="accent">#FF5A28</color>
</resources>
